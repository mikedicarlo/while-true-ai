    "@while-true-ai/integrations": "workspace:*",
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-select-input": "^6.0.0",
    "react": "^18.3.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/js-yaml": "^4.0.9",
    "tsup": "^8.4.0",
