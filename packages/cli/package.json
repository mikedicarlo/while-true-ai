{
  "name": "while-true-ai",
  "version": "0.1.0",
  "description": "An autonomous AI agent that runs on your local machine",
  "type": "module",
  "license": "MIT",
  "author": "Mike DiCarlo",
  "repository": {
    "type": "git",
    "url": "https://github.com/mikedicarlo/while-true-ai.git",
    "directory": "packages/cli"
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "llm",
    "openai",
    "anthropic",
    "claude",
    "gpt",
    "cli",
    "terminal",
    "automation"
  ],
  "bin": {
    "while-true-ai": "./dist/bin/while-true-ai.js"
  },
  "files": [
